# PlantCare AI - Environment Configuration Template

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration (SQLite default; PostgreSQL ready)
DATABASE_URL=sqlite:///./plantcare.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/plantcare_db

# ML Model Configuration
MODEL_PATH=models/disease_model.pt
MODEL_DEVICE=cpu # or cuda

# Storage Configuration
STORAGE_BACKEND=local # local, s3, cloudinary
UPLOAD_DIR=uploads

# Admin API Security
ADMIN_API_KEY=plantcare-admin-secret-2026

# Weather API (Optional future integration)
OPENWEATHER_API_KEY=

# Frontend Configuration
VITE_API_URL=http://localhost:8000
